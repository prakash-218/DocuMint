# Local development defaults (see README "Configuration")
DATABASE_URL=postgresql+psycopg://postgres:dev@127.0.0.1:5434/documint
SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=development

# Files: a local folder unless S3_BUCKET is set
STORAGE_DIR=var/storage
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Email sync (worker). One prefix per mailbox.
# EMAIL_ACCOUNTS=INFO,RAMESH
# INFO_IMAP_HOST=mail.kkrengineering.com
# INFO_IMAP_USER=info@kkrengineering.com
# INFO_IMAP_PASSWORD=
# RAMESH_IMAP_HOST=mail.kkrengineering.com
# RAMESH_IMAP_USER=ramesh@kkrengineering.com
# RAMESH_IMAP_PASSWORD=
# Or, when a Gmail collects the company mail over POP, read that Gmail (app password) and keep personal mail out:
# EMAIL_ACCOUNTS=GMAIL
# EMAIL_ORG_DOMAIN=kkrengineering.com
# GMAIL_IMAP_HOST=imap.gmail.com
# GMAIL_IMAP_USER=
# GMAIL_IMAP_PASSWORD=
# GMAIL_IMAP_FOLDERS=[Gmail]/All Mail
# GMAIL_IMAP_MATCH=kkrengineering.com
